/ios/Pods/
Pods/

# ---------- Firebase ----------
# هذه الملفات مطلوبة للنشر على App Store / Play Store - تم السماح برفعها
# حتى يتمكن الشخص الآخر من عمل build مباشرة بدون flutterfire configure
# لو المستودع Public وتريد حماية المفاتيح، احذف التعليق "#" لإخفائها
# ملاحظة: تأكد من تقييد الـ API Key في Google Cloud Console (HTTP referrer / Bundle ID)
#android/app/google-services.json
#ios/Runner/GoogleService-Info.plist
#ios/firebase_app_id_file.json
#lib/firebase_options.dart
# dart-define & firebase env
.env
.env.*
*.env

