# ============================================================
# Nour Ramadan - Flutter .gitignore (جاهز للرفع على GitHub)
# ============================================================

# ---------- Dart / Flutter ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages
/build/
**/doc/api/
**/ios/Flutter/.last_build_id
# pubspec.lock - للتطبيقات (App) يُفضل عمل commit له لضمان نفس نسخ المكتبات
# لو مشروعك Package/Library فقط احذف "#" من السطر التالي:
# pubspec.lock

# Generated files (اختياري - لو تريد تجاهلها احذف "#")
# ملاحظة: مشروعك يستخدم riverpod_generator و hive_generator
# يُفضل عمل commit لملفات *.g.dart حتى يعمل المشروع مباشرة بعد clone بدون build_runner
# lib/generated/
# *.g.dart
# *.freezed.dart
# *.gr.dart
# *.gen.dart

# Coverage & Tests
coverage/
test/coverage/
lcov.info

# ---------- Android ----------
# ملفات حساسة - لا ترفعها أبداً على GitHub العام
android/local.properties
android/key.properties
*.jks
*.keystore
*.p12
*.keystore.bak
pepk.jar
upload-keystore.jks

# Android build outputs
/android/app/debug
/android/app/profile
/android/app/release
/android/app/build/
/android/build/
/android/.gradle/
android/app/*.apk
android/app/*.aab
gradle-wrapper.jar

