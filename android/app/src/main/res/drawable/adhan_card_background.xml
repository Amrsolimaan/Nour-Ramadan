<?xml version="1.0" encoding="utf-8"?>
<!--
    adhan_card_background.xml
    
    Card background for AdhanActivity
    Matches nightCard color (#221A40) with gold border
    Rounded corners for modern look
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Card background color (nightCard) -->
    <solid android:color="#221A40" />
    
    <!-- Gold border (borderGoldStrong) -->
    <stroke
        android:width="1dp"
        android:color="#99C8922A" />
    
    <!-- Rounded corners -->
    <corners android:radius="16dp" />
    
</shape>
